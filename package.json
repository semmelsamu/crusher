{
    "name": "crusher",
    "version": "0.0.1-SNAPSHOT",
    "description": "Boulder / rock climbing tracking and management tool",
    "scripts": {
        "build:css": "postcss ./src/main/resources/static/css/main.css -o ./src/main/resources/static/css/_build.css --minify",
        "watch:css": "postcss ./src/main/resources/static/css/main.css -o ./src/main/resources/static/css/_build.css --watch",
        "prepare": "husky"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "postcss": "^8.4.47",
        "postcss-cli": "^11.0.0",
        "prettier": "^3.7.1",
        "tailwindcss": "^4.0.0"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    }
}
