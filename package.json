{
  "name": "crusher",
  "version": "0.0.1-SNAPSHOT",
  "description": "Boulder / rock climbing tracking and management tool",
  "scripts": {
    "build:css": "postcss ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/styles.css --minify",
    "watch:css": "postcss ./src/main/resources/static/css/input.css -o ./src/main/resources/static/css/styles.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0"
  }
}
