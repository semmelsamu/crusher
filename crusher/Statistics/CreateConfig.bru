meta {
  name: CreateConfig
  type: http
  seq: 1
}

post {
  url: http://localhost:8080/api/statistics
  body: json
  auth: inherit
}

body:json {
  {
    "goesPerGradeEnabled": true,
    "finishedGoesPerGradeEnabled": true,
    "resultDistributionEnabled": true,
    "highestFinishedGradeEnabled": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
